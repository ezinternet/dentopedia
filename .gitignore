# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Obsidian — exclude plugins/themes (too large), keep only core config
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/plugins/
.obsidian/themes/

# Audit logs — auto-generated by scripts/daily-audit.py (not knowledge)
# Ignore log files, but keep hand-written .md analysis docs (e.g. decay-triage)
logs/*
!logs/*.md

# Recall pending queue — transient, created/deleted within one weekly-recall
# batch lifecycle (scripts/recall-session.py --write-pending/--clear-pending).
# Not knowledge; recall/_state.json (the durable Leitner state) stays tracked.
recall/_pending.json

# Claudian plugin
.claudian/

# Claude local settings
.claude/settings.local.json

# PDFs — stored locally only (too large for GitHub)
papers/*.pdf
papers/**/*.pdf
# 루트 스테이징 PDF — 인제스트 입력물이지 지식이 아니다.
# 2026-08-25: 루트에 16개가 쌓여 있었고 그중 10개가 이미 인제스트된 논문의 재다운로드였다.
# ingest-deviations의 duplicate-skip 22건 상당수가 이 루트 재스테이징이 원인
# ("Root-level staging PDF ... byte-identical restage of already-ingested").
/*.pdf
.ingest-queue
.ingest-watcher.log
.claude/scripts/weekly-digest.log
.claude/scripts/qmd-cleanup.log

# Quartz build artifacts
quartz/node_modules/
quartz/public/
quartz/.quartz-cache/
# NOTE: quartz/content is NOT gitignored — Quartz uses globby with
# gitignore:true, which would cause it to skip all files in content/
# and emit 0 pages. The directory is recreated by the deploy workflow
# from wiki/ on each build.


# Local Netlify folder
.netlify

# Smart Connections cache (binary blobs, 100MB+ files)
.smart-env/
