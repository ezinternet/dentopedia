summaries:
  year: Earliest
filters:
  and:
    - file.inFolder("wiki")
    - 'file.ext == "md"'
    - not:
        - file.inFolder("wiki/overviews")
        - file.inFolder("wiki/_meta")
        - file.inFolder("wiki/_lint")
    - or:
        - 'evidence_level == "sr+ma"'
        - 'evidence_level == "sr"'
formulas:
  evidence_badge: 'if(evidence_level == "sr+ma", "SR+MA ⭐", "SR")'
  decade: 'if(year, if(year >= 2020, "2020s", if(year >= 2010, "2010s", "2000s")), "")'
properties:
  title:
    displayName: Title
  year:
    displayName: Year
  evidence_level:
    displayName: "Study Type"
  authors:
    displayName: Authors
  formula.evidence_badge:
    displayName: Evidence
  category:
    displayName: Category
  formula.decade:
    displayName: Decade
views:
  - type: table
    name: "SR+MA Only (최고 근거)"
    filters: 'evidence_level == "sr+ma"'
    groupBy:
      property: year
      direction: DESC
    order:
      - file.name
      - formula.evidence_badge
      - year
      - category
  - type: table
    name: "SR+MA + SR (카테고리별)"
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - formula.evidence_badge
      - year
      - category
  - type: table
    name: "연도별 (All Systematic Reviews)"
    groupBy:
      property: formula.decade
      direction: DESC
    order:
      - file.name
      - formula.evidence_badge
      - category
  - type: cards
    name: "Card View"
    order:
      - file.name
      - formula.evidence_badge
      - year
      - category
